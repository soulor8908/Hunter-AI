# Hunter AI 环境变量示例
# 复制为 .env.local（前端开发用）或 .dev.vars（Worker 本地开发用）

# ===== 前端（Vite 构建）=====
# 可选：覆盖 Trial Worker 地址（默认同源 /api/ai，生产环境无需配置）
# 开发时若想用远程 Worker，可设置为 https://hunter-ai-worker.<account>.workers.dev/api/ai
VITE_TRIAL_WORKER_URL=/api/ai

# 可选：默认 AI provider 和模型
VITE_DEFAULT_AI_PROVIDER=trial
VITE_DEFAULT_AI_MODEL=

# ===== Worker（Cloudflare Dashboard → Settings → Variables 中配置 secret）=====
# Trial 模式 AI 网关（用户未自带 Key 时降级使用）
AI_GATEWAY_PROVIDER=deepseek
AI_GATEWAY_API_KEY=sk-xxxxxxxxxxxxxxxx
AI_GATEWAY_MODEL=deepseek-chat
TRIAL_DAILY_QUOTA_PER_IP=20

# Embedding（共享 JD 池 + Trial embedding 代理）
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxx
EMBEDDING_MODEL=text-embedding-3-small

# CORS（同域部署时无需配置）
CORS_ALLOW_ORIGIN=*
