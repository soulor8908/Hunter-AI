# Hunter AI 环境变量示例
# 复制为 .env 或在 Cloudflare Worker 配置 secrets

# 用户端（可选，用户也可在 UI 设置中填写，仅存浏览器 IndexedDB）
VITE_DEFAULT_AI_PROVIDER=deepseek
VITE_DEFAULT_AI_MODEL=deepseek-chat

# Worker 端（Trial 模式用，仅在用户未自带 Key 时降级使用）
# 在 Cloudflare Dashboard → Worker → Settings → Variables 配置：
# AI_GATEWAY_PROVIDER=deepseek
# AI_GATEWAY_API_KEY=your_key_here
# TRIAL_DAILY_QUOTA_PER_IP=20
